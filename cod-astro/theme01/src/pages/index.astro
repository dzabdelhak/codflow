---
// ── Home page layout ────────────────────────────────────────────────────────
// Rendered from the channel's section list (its published design document):
// order, visibility and texts come from there. Streaming components fetch
// their own data in parallel.
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import Hero from "@/theme/components/home/Hero.astro";
import CategoryCards from "@/theme/components/home/CategoryCards.astro";
import BestSellers from "@/theme/components/home/BestSellers.astro";
import HowItWorks from "@/theme/components/home/HowItWorks.astro";
import NewArrivals from "@/theme/components/home/NewArrivals.astro";
import FeaturesBar from "@/theme/components/home/FeaturesBar.astro";
import WhatsAppCTA from "@/theme/components/home/WhatsAppCTA.astro";
import CustomerTestimonials from "@/theme/components/home/CustomerTestimonials.astro";
import LandingPage from "@/theme/components/landing/LandingPage.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingChannel } from "@/core/api/client";
import { isLandingChannel } from "@/theme/utils/landing-view";
import { contentWithSections, LANDING_SECTIONS, pageSections, STORE_HOME_SECTIONS } from "@/theme/utils/sections";
import { actions, isInputError } from "astro:actions";
import { thankYouUrl } from "@/core/utils/thank-you-url";

const { config, content, isRTL } = await getStoreContext();

const landing = isLandingChannel(config) ? await fetchLandingChannel() : null;
const result = isLandingChannel(config) ? Astro.getActionResult(actions.placeOrder) : undefined;
if (result?.data?.orderNumber) {
  return Astro.redirect(thankYouUrl(result.data), 303);
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;
const landingProduct = landing?.product ?? null;
const homeSections = pageSections(config, STORE_HOME_SECTIONS);
const homeContent = contentWithSections(content, homeSections);
const landingContent = contentWithSections(content, pageSections(config, LANDING_SECTIONS));
const landingTitle = config.metaTitle ?? (landingProduct ? `${landingProduct.name} — ${config.name}` : config.name);
---

{isLandingChannel(config) ? (
<StoreLayout
  config={config}
  content={landingContent}
  title={landingTitle}
  ogImage={landingProduct?.images?.[0]?.src}
  landing={true}
>
  {landing && landingProduct ? (
    <LandingPage
      landing={{ ...landing, product: landingProduct }}
      config={config}
      content={content}
      isRTL={isRTL}
      fieldErrors={fieldErrors}
      serverError={serverError}
    />
  ) : (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center" role="status">
      <h1 class="text-2xl font-black" style="color: var(--clr-text)">{content.landingUnavailableTitle}</h1>
      <p class="mt-2 text-sm font-bold" style="color: var(--clr-text-2)">{content.landingUnavailableBody}</p>
    </div>
  )}
</StoreLayout>
) : (
<StoreLayout config={config} content={homeContent}>
  {homeSections.map((section) =>
    section.type === "hero" ? (
      <Hero content={homeContent} image={section.settings.heroImage} ctaHref={section.settings.heroCtaHref} />
    ) : section.type === "categories" ? (
      <CategoryCards content={homeContent} />
    ) : section.type === "best_sellers" ? (
      <BestSellers currencySymbol={config.currencySymbol} content={homeContent} />
    ) : section.type === "how_it_works" ? (
      <HowItWorks content={homeContent} />
    ) : section.type === "new_arrivals" ? (
      <NewArrivals currencySymbol={config.currencySymbol} content={homeContent} />
    ) : section.type === "features" ? (
      <FeaturesBar content={homeContent} />
    ) : section.type === "promo" ? (
      <WhatsAppCTA content={homeContent} ctaHref={section.settings.promoCtaHref} />
    ) : section.type === "testimonials" ? (
      <CustomerTestimonials config={config} content={homeContent} />
    ) : null,
  )}
</StoreLayout>
)}
