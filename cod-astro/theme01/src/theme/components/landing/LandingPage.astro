---
// ── LANDING CHANNEL ──────────────────────────────────────────────────────────
// One page around the channel's main product: banner, product, gallery,
// benefits, price, order form, FAQ, reassurance. The order form is the SAME
// OrderForm the product page uses (same DOM contract and scripts). While the
// product is unavailable the channel's rule decides what replaces the form.
// ─────────────────────────────────────────────────────────────────────────────
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import ProductDescription from "@/theme/components/product/ProductDescription.astro";
import { Icon } from "astro-icon/components";
import type { LandingChannel, StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { filledTexts, landingOrderSection } from "@/theme/utils/landing-view";

interface Props {
  landing: LandingChannel & { product: NonNullable<LandingChannel["product"]> };
  config: StoreConfig;
  content: StoreFrontContent;
  isRTL: boolean;
  fieldErrors: any;
  serverError: string | null;
}

const { landing, config, content, isRTL, fieldErrors, serverError } = Astro.props;
const product = landing.product;
const cur = config.currencySymbol;
const defaultVariant = product.hasVariants
  ? (product.variants.find((v: { isDefault?: boolean }) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice: number = defaultVariant?.price ?? product.price;
const comparePrice: number | null = defaultVariant?.compareAtPrice ?? product.compareAtPrice ?? null;
const hasDiscount = comparePrice != null && comparePrice > basePrice;
const discountPct = hasDiscount ? Math.round((1 - basePrice / comparePrice!) * 100) : 0;
const images: Array<{ id: string; src: string; altText: string | null }> = product.images ?? [];
const cover = images[0] ?? null;
const section = landingOrderSection(landing);
const benefits = filledTexts(content.landingBenefit1, content.landingBenefit2, content.landingBenefit3, content.landingBenefit4);
const faq = [
  { q: content.landingFaq1Q, a: content.landingFaq1A },
  { q: content.landingFaq2Q, a: content.landingFaq2A },
  { q: content.landingFaq3Q, a: content.landingFaq3A },
].filter((item) => item.q?.trim() && item.a?.trim());
const reassurance = [
  { icon: "heroicons:credit-card", title: content.trust1Title, sub: content.trust1Sub },
  { icon: "heroicons:truck", title: content.trust2Title, sub: content.trust2Sub },
  { icon: "heroicons:bolt", title: content.trust3Title, sub: content.trust3Sub },
];
const fmt = (n: number) => n.toLocaleString("ar-DZ");
---

{section === "form" && (
  <div
    id="page-data"
    class="sr-only"
    data-variants={JSON.stringify(product.variants)}
    data-base-price={basePrice}
    data-compare-price={comparePrice ?? ""}
    data-cur={cur}
    data-is-rtl={isRTL ? "1" : "0"}
    data-shipping-label={content.shippingLabel}
    data-shipping-calc={content.shippingCalculated}
    data-shipping-free={content.shippingFree}
    data-total-label={content.totalLabel}
    data-commune-placeholder={content.formCommunePlaceholder}
    data-commune-loading={content.formCommuneLoading}
    data-commune-disabled={content.formCommuneDisabled}
    data-offers={JSON.stringify(product.offers)}
    data-offer-free-label={content.offerFreeLabel}
    data-offer-active={content.offerActive}
    data-offer-unlocked={content.offerUnlocked}
    data-offer-add-more={content.offerAddMore}
    data-offer-add-one={content.offerAddOne}
    data-offer-you-get={content.offerYouGet}
    data-track-inventory={product.trackInventory ? "1" : "0"}
    data-shipping-to-confirm={content.shippingToConfirm}
    data-stock-not-guaranteed={content.stockNotGuaranteed}
    data-inventory={String(product.inventory)}
    data-pixel-id={config.pixelId ?? ""}
    data-phone-invalid={content.formPhoneInvalid}
    data-product-id={product.id}
    data-product-name={product.name}
  />
)}
{section === "form" && <ShippingIsland server:defer productId={product.id} />}

<section data-landing-section="banner" class="px-4 pt-8 pb-6 sm:pt-12">
  <div class="mx-auto max-w-5xl grid gap-6 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="text-xs font-black uppercase tracking-widest" style="color: var(--clr-primary)">{content.landingEyebrow}</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-black leading-tight tracking-tight" style="color: var(--clr-text)">{product.name}</h1>
      <p class="mt-4 text-3xl font-black" style="color: var(--clr-primary)">
        {fmt(basePrice)} <span class="text-lg font-bold">{cur}</span>
      </p>
      {section === "form" && (
        <a href="#order-section-wrapper" class="btn-primary mt-6 inline-flex items-center gap-2">
          {content.orderCta}
          <Icon name="heroicons:chevron-down" class="w-5 h-5" />
        </a>
      )}
    </div>
    {cover && (
      <img
        src={cover.src}
        alt={cover.altText ?? product.name}
        class="block w-full h-auto rounded-[var(--radius-card)]"
        style="background: var(--clr-surface);"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </div>
</section>

{product.description && (
  <section data-landing-section="product" class="px-4 py-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-4 text-xl font-black" style="color: var(--clr-text)">{content.landingDescriptionTitle}</h2>
      <ProductDescription description={product.description} format={product.descriptionFormat} />
    </div>
  </section>
)}

{images.length > 1 && (
  <section data-landing-section="gallery" class="px-4 py-6">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-4 text-xl font-black" style="color: var(--clr-text)">{content.landingGalleryTitle}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {images.slice(1).map((image) => (
          <img
            src={image.src}
            alt={image.altText ?? product.name}
            class="block w-full aspect-square object-cover rounded-[var(--radius-card)]"
            style="background: var(--clr-surface);"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </section>
)}

{benefits.length > 0 && (
  <section data-landing-section="benefits" class="px-4 py-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-4 text-xl font-black" style="color: var(--clr-text)">{content.landingBenefitsTitle}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {benefits.map((benefit) => (
          <li class="card flex items-start gap-3 p-4">
            <Icon name="heroicons:check-badge" class="w-5 h-5 shrink-0 text-primary" />
            <span class="text-sm font-bold" style="color: var(--clr-text)">{benefit}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<section data-landing-section="price" class="px-4 py-6">
  <div class="mx-auto max-w-xl card p-5 text-center">
    <p class="text-xs font-black uppercase tracking-widest" style="color: var(--clr-text-2)">{content.landingPriceTitle}</p>
    <p class="mt-2 text-4xl font-black" style="color: var(--clr-primary)">
      {fmt(basePrice)} <span class="text-xl font-bold">{cur}</span>
    </p>
    {hasDiscount && (
      <p class="mt-1 text-sm font-bold" style="color: var(--clr-text-2)">
        <span class="line-through">{fmt(comparePrice!)} {cur}</span>
        <span class="ms-2" style="color: var(--clr-primary)">{content.landingDiscountLabel.replace("{pct}", String(discountPct))}</span>
      </p>
    )}
  </div>
</section>

{section === "form" && (
  <section data-landing-section="order-form" class="px-4 py-8" id="order-section-wrapper">
    <div class="max-w-xl mx-auto">
      <OrderForm
        product={product}
        content={content}
        fieldErrors={fieldErrors}
        serverError={serverError}
        basePrice={basePrice}
        defaultVariant={defaultVariant ?? null}
        cur={cur}
        isRTL={isRTL}
        offers={product.offers}
        defaultVariantId={defaultVariant?.id ?? null}
        otpEnabled={config.otpEnabled === true}
        turnstileEnabled={config.turnstileEnabled === true}
        turnstileSiteKey={config.turnstileSiteKey ?? null}
        pages={config.pages ?? []}
        formPolicy={config.checkoutForm}
      />
    </div>
  </section>
)}

{section === "unavailable" && (
  <section data-landing-section="unavailable" class="px-4 py-8">
    <div class="mx-auto max-w-xl card p-6 text-center" role="status">
      <Icon name="heroicons:exclamation-triangle" class="mx-auto w-8 h-8" style="color: var(--clr-text-2)" />
      <h2 class="mt-3 text-xl font-black" style="color: var(--clr-text)">{content.landingUnavailableTitle}</h2>
      <p class="mt-2 text-sm font-bold" style="color: var(--clr-text-2)">{content.landingUnavailableBody}</p>
    </div>
  </section>
)}

{faq.length > 0 && (
  <section data-landing-section="faq" class="px-4 py-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-4 text-xl font-black" style="color: var(--clr-text)">{content.landingFaqTitle}</h2>
      <div class="space-y-3">
        {faq.map((item) => (
          <details class="card p-4">
            <summary class="cursor-pointer text-sm font-black" style="color: var(--clr-text)">{item.q}</summary>
            <p class="mt-2 text-sm font-medium" style="color: var(--clr-text-2)">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section data-landing-section="reassurance" class="px-4 py-8">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-4 text-center text-xl font-black" style="color: var(--clr-text)">{content.landingReassuranceTitle}</h2>
    <div class="grid gap-3 sm:grid-cols-3">
      {reassurance.map((item) => (
        <div class="card flex items-center gap-3 p-4">
          <Icon name={item.icon} class="w-6 h-6 shrink-0 text-primary" />
          <div>
            <p class="text-sm font-black" style="color: var(--clr-text)">{item.title}</p>
            <p class="text-xs font-bold" style="color: var(--clr-text-2)">{item.sub}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{section === "form" && (
  <a href="#order-section-wrapper" id="lp-sticky-cta" class="btn-primary lp-sticky-cta">
    {content.orderCta}
    <Icon name="heroicons:chevron-down" class="w-5 h-5" />
  </a>
)}

{section === "form" && (
  <>
    <script src="../../scripts/product.ts"></script>
    <script src="../../scripts/lp-sticky-cta.ts"></script>
    <script src="../../scripts/otp-step.ts"></script>
    <script src="../../scripts/turnstile-field.ts"></script>
    <script src="../../scripts/track-abandonment.ts"></script>
  </>
)}

<style>
  .lp-sticky-cta {
    position: fixed;
    bottom: calc(var(--safe-bottom) + 0.75rem);
    inset-inline: 0;
    margin-inline: auto;
    width: min(24rem, calc(100% - 2rem));
    z-index: 45;
    box-shadow: var(--shadow-primary);
    font-weight: 800;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .lp-sticky-cta.is-hidden {
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }
</style>
