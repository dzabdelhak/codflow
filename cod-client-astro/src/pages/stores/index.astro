---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import StoresPageApp from "@/features/stores/StoresPageApp";
---

<BaseLayout title="Orestore">
  <main class="min-h-screen">
    <div data-gate-spinner="required" class="flex min-h-screen items-center justify-center" aria-busy="true">
      <GateSpinner branded />
    </div>
    <div data-auth-gate="required" hidden>
      <StoresPageApp client:only="react" />
    </div>
  </main>
</BaseLayout>
