# CodFlow dashboard (Astro on Node) — environment. Never commit real values.
#
# Build time (inlined into the browser bundle; rebuild to change):
#   PUBLIC_API_URL          cod-server origin the browser calls
#
# Run time (server only):
#   DATABASE_URL            the platform PostgreSQL (same database as cod-server)
#   REDIS_URL               sessions cache and rate limits
#   PUBLIC_APP_URL          this dashboard's public origin (better-auth base URL)
#   PUBLIC_TRUSTED_ORIGINS  extra comma-separated origins allowed to call auth
#   BETTER_AUTH_SECRET      openssl rand -hex 32 — must match cod-server's
#
# docker compose sets all of these for local use (see docker-compose.yml).

PUBLIC_API_URL=http://localhost:8787
DATABASE_URL=postgres://codflow:codflow@localhost:5440/codflow
REDIS_URL=redis://localhost:6390
PUBLIC_APP_URL=http://localhost:4321
# BETTER_AUTH_SECRET=
