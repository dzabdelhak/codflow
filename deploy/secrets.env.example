# Orestor production secrets. Copy to /etc/codflow/secrets.env (chmod 600,
# owned by root), fill every value, then run deploy/install.sh. This file is
# the only thing a server needs besides the repository; never commit it.
# Generate random values with:  openssl rand -hex 32

# ── Public addresses ────────────────────────────────────────────────────────
# api.<BASE_DOMAIN>, app.<BASE_DOMAIN> and status.<BASE_DOMAIN> must point at
# this server, and so must *.<BASE_DOMAIN> (free channel addresses).
BASE_DOMAIN=example.dz
# Let's Encrypt account e-mail.
ACME_EMAIL=ops@example.dz
# Where merchants point their own domains: a CNAME to CUSTOM_DOMAIN_TARGET, or
# A records to CUSTOM_DOMAIN_IPV4 (this server's public IPv4, comma-separated).
CUSTOM_DOMAIN_TARGET=stores.example.dz
CUSTOM_DOMAIN_IPV4=203.0.113.10

# ── First account (created once, on the first install) ─────────────────────
MERCHANT_ID=main
MERCHANT_NAME=Main merchant
ADMIN_EMAIL=admin@example.dz

# ── Application secrets (letters, digits, - and _ only) ────────────────────
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
STOREFRONT_SERVICE_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Where orders are transmitted: "test" until the Aventy connector exists.
ORDER_DESTINATION=test
# Encrypts each channel's Aventy key at rest (openssl rand -hex 32). Keep a
# copy outside this server: a restored database is useless without it. To
# rotate, move the old value to _PREVIOUS and set a new one.
AVENTY_KEY_ENCRYPTION_KEY=
AVENTY_KEY_ENCRYPTION_KEY_PREVIOUS=

# Shared with Aventy: verifies the signed one-time link of its "Créer un canal
# de vente" button (openssl rand -hex 32). Empty: the link is refused.
AVENTY_LINK_SECRET=

# ── Monitoring (Uptime Kuma at https://status.<BASE_DOMAIN>) ───────────────
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=
ALERT_EMAIL_FROM=alerts@example.dz
ALERT_EMAIL_TO=ops@example.dz
SMTP_HOST=smtp.example.dz
# STARTTLS submission port.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Disk use (percent) that turns the disk monitor red.
DISK_ALERT_PERCENT=85

# ── Off-server backups ──────────────────────────────────────────────────────
# An rclone remote named "backup", on storage hosted in Algeria (law 18-07).
# BACKUP_REMOTE is the remote and folder the dumps and images go to. S3 shown;
# for SFTP use RCLONE_CONFIG_BACKUP_TYPE=sftp with _HOST, _USER and
# _KEY_PEM. To encrypt at rest, define a "crypt" remote over it
# (RCLONE_CONFIG_SECURE_TYPE=crypt, _REMOTE=backup:bucket, _PASSWORD=<rclone obscure …>)
# and set BACKUP_REMOTE=secure:.
BACKUP_REMOTE=backup:codflow-backups
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
RCLONE_CONFIG_BACKUP_ENDPOINT=https://s3.backup.example.dz
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=

# ── Test installs only ──────────────────────────────────────────────────────
# "local_certs" makes Caddy use its own CA instead of Let's Encrypt, for a
# rehearsal on a machine without public DNS. Leave empty in production.
CADDY_GLOBAL_EXTRA=
