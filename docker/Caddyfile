# Local front proxy. api.* is the API, app.* the dashboard; every other
# hostname is a channel served by the storefront. Caddy passes the Host header
# through unchanged.
#
# HTTPS (:8443 on the host) issues a certificate on the first visit to a
# hostname, from Caddy's local CA, and only for hostnames cod-server's
# /platform/tls-ask accepts (verified channel domains). Production uses the
# same rule with Let's Encrypt — see Caddyfile.production.example.
{
	auto_https disable_redirects
	on_demand_tls {
		ask http://api:8787/platform/tls-ask
	}
}

http://api.localhost {
	respond /platform/* 404
	reverse_proxy api:8787
}

http://app.localhost {
	reverse_proxy dashboard:4321
}

http://aventy.localhost {
	reverse_proxy aventy-demo:8080
}

http:// {
	reverse_proxy storefront:4321 {
		header_up X-Visitor-IP {remote_host}
	}
}

https:// {
	tls internal {
		on_demand
	}
	reverse_proxy storefront:4321 {
		header_up X-Visitor-IP {remote_host}
	}
}
