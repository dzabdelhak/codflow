{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022"
    ],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "drizzle-orm": [
        "./node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "./node_modules/drizzle-orm/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../cod-shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "../cod-shared/queries/landing-page-tracking.test.ts",
    "src/cron/sweep-orphan-images.test.ts",
    "src/endpoints/delivery-companies/webhook-events.e2e.test.ts",
    "src/endpoints/images/images.test.ts",
    "src/endpoints/landing-pages/landing-pages.api-e2e.test.ts",
    "src/endpoints/landing-pages/landing-pages.attribution-e2e.test.ts",
    "src/endpoints/landing-pages/landing-pages.hidden-product-e2e.test.ts",
    "src/endpoints/landing-pages/landing-pages.public-e2e.test.ts",
    "src/endpoints/landing-pages/landing-pages.schema-e2e.test.ts",
    "src/endpoints/mcp/handlers.test.ts",
    "src/endpoints/orders/dispatch-limits-e2e.test.ts",
    "src/endpoints/orders/orders.webhook-e2e.test.ts",
    "src/endpoints/shipping-profiles/routes.test.ts",
    "src/endpoints/store/capi-checkout-decision.test.ts",
    "src/endpoints/store/capi-lead-trigger.test.ts",
    "src/endpoints/webhooks/yalidine-webhook.e2e.test.ts",
    "src/mcp/authorize.test.ts",
    "src/mcp/registry.test.ts",
    "src/mcp/server-factory.test.ts",
    "src/workflows/capi-destination.test.ts",
    "src/workflows/landing-page-image-upload.test.ts"
  ]
}
