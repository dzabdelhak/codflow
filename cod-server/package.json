{
  "name": "codflow-server",
  "version": "1.1.0",
  "description": "Orestore API — Hono on Node.js + PostgreSQL (ADR-0003)",
  "main": "src/node.ts",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:legal-pages": "tsx scripts/seed-store-pages.ts",
    "db:setup": "npm run db:migrate && npm run db:seed:demo && npm run db:seed:legal-pages",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:performance": "vitest --run tests/performance",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html",
    "images:import-legacy": "tsx scripts/import-legacy-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@better-auth/oauth-provider": "^1.7.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "^2.3.0",
    "ai": "^7.0.70",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
